---
import '../styles/global.css';
import { meta } from '../lib/data.js';
import { ago } from '../lib/format.js';
import { indexable, site, u } from '../lib/site.js';

const { title, description, current } = Astro.props;
const nav = [
  ['/', 'Latency'],
  ['/paths/', 'Paths'],
  ['/residency/', 'Residency'],
  ['/advisor/', 'Advisor'],
  ['/methodology/', 'Methodology'],
  ['/contact/', 'Contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Sovereign</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>📡</text></svg>" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={u('/')}>Sovereign</a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={u(href)} aria-current={current === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          Independent latency and data-residency measurement for Gulf cloud regions.
          Measurements from volunteer probes; methodology published in full.
        </p>
        {!indexable && (
          <p>
            <span class="pill draft">unlisted</span>
            {' '}Not indexed by search engines while the dataset and the
            residency entries are still early.
          </p>
        )}
        <p>
          {meta.generated_at
            ? <>Data generated {ago(meta.generated_at)} · window {meta.window} · <a href={u('/methodology/')}>how this is measured</a></>
            : <>No snapshot built into this site yet.</>}
        </p>
        <p>
          Measurements are licensed <a href={meta.license.url} rel="license">{meta.license.name}</a>
          {' '}— reuse them with credit. The software is MIT and licensed
          separately. <a href={`${site.repo}/blob/main/LICENSE-DATA.md`}>Details</a>
        </p>
      </div>
    </footer>
  </body>
</html>
