<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sovereign.probe</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/agent/bin/probe</string>
    <string>-server</string>
    <string>http://127.0.0.1:8000</string>
    <string>-state</string>
    <string>__ROOT__/agent/state</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>WorkingDirectory</key>
  <string>__ROOT__/agent</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/logs/probe.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/logs/probe.log</string>
</dict>
</plist>
