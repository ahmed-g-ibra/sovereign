<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sovereign.stack</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/ops/run-stack.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Docker may not be up yet at login; back off rather than spin. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/logs/stack.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/logs/stack.log</string>
</dict>
</plist>
