# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
.terraform.lock.hcl.bak

# Go
/agent/bin/
/agent/probe
*.test
*.out

# Measurements (keep the code in git, not the data)
*.ndjson
/data/*

# macOS
.DS_Store
!/data/.gitkeep

# Agent runtime state: holds the probe's PRIVATE KEY and its spool.
# Never commit this.
/agent/state/
**/state/identity.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
